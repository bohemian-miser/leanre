  "generic_portability_bugs": [
    {
      "id": "XREPO-01",
      "severity": "HIGH",
      "component": "leanre/leanre.py",
      "title": "leanre scan/all defaults --root to 'Main' instead of 'auto'",
      "repro": "python3 leanre/leanre.py scan data/corpora/<repo> --out-db ...",
      "observed": "Exit 1 (ValueError: Root module 'Main' not found) on all 4 real corpora (PrimeNumberTheoremAnd, carleson, FLT, SpherePacking), even though leanre/scanner.py defaults --root to 'auto'. Also leanre.py scan/forensics do not accept --config.",
      "workaround": "Pass --root auto (or run python3 leanre/scanner.py --config ... directly)."
    },
    {
      "id": "XREPO-02",
      "severity": "HIGH",
      "component": "leanre/scanner.py",
      "title": "--root auto picks blueprint-verso submodule on FLT (reach=34/271 vs 261/271) and discover_lean_files walks non-lib dirs",
      "repro": "python3 leanre/leanre.py scan data/corpora/FLT --root auto --out-db ...",
      "observed": "discover_lean_files only skips (.lake, .git, build), scanning blueprint-verso/, scripts/, examples/. Because FLT.lean is imported by FermatsLastTheorem.lean and blueprint-verso, FLT has fan_in>0, so --root auto chose blueprint-verso.FLTBlueprint.Chapters.Level02ReductionToPrimeCase (fan_in=0), yielding reach=34/271 instead of 261/271.",
      "workaround": "Run leanre/scanner.py --config <leanre.toml> (or pass --root FLT)."
    },
    {
      "id": "XREPO-03",
      "severity": "HIGH",
      "component": "leanre/kernel.py",
      "title": "kernel extract ignores leanre.toml and marks 100% of decls dead without manual --root",
      "repro": "python3 leanre/leanre.py kernel extract --input examples/tiny_demo/demo.ndjson --out-dir ... --leanre-db ... --src-dir examples/tiny_demo",
      "observed": "Logs 'RH defaults absent; proceeding with 0 roots' (k4_union_live=0, k4_union_dead=17), which causes downstream `leanre bundles` to report 0 live structures and `leanre portability` to emit null dom metrics.",
      "workaround": "Pass --root TinyDemo.main_theorem:DEMO explicitly."
    },
    {
      "id": "XREPO-04",
      "severity": "HIGH",
      "component": "leanre/trim.py",
      "title": "leanre trim defaults --src/--leanre-db/--tier1-db to RH workspace files and hardcodes 'pinned to 40e56bab'",
      "repro": "python3 leanre/leanre.py trim --kernel-db <tiny_demo_kernel.db>",
      "observed": "Silently mixed 10 tiny_demo live kernel decls with RH data/rh_mirror/src (175,187 modules, 17,374,215 lines) and RH outputs/leanre.db, printing 'pinned to 40e56bab' even when all flags are explicitly overridden.",
      "workaround": "Pass --src, --leanre-db, --tier1-db explicitly (banner still prints RH commit pin)."
    },
    {
      "id": "XREPO-05",
      "severity": "MEDIUM",
      "component": "leanre/flirt/tier1.py",
      "title": "flirt tier1 calibrates against RH outputs/kernel/kernel.db by default, prints RH F1 lines, and over-flags Mathlib-extension repos",
      "repro": "python3 leanre/leanre.py flirt tier1 --src data/corpora/FLT --db ... --summary ...",
      "observed": "Default --kernel-db opens RH outputs/kernel/kernel.db (contaminating kernel_precision_calibration with 0/N live rate), prints RH-specific F1 AbelianVarietyTheory lines, and flags 48.1% (113/235) of PNT+ and 39.1% (106/271) of FLT as misfiles due to intentional Mathlib-extension namespaces (e.g., AddSubgroup, riemannZeta).",
      "workaround": "Pass --kernel-db '' to disable RH cross-check."
    },
    {
      "id": "XREPO-06",
      "severity": "MEDIUM",
      "component": "leanre/bundles.py & leanre/decompile/source.py & leanre/export_site.py",
      "title": "Hardcoded 'src/' anchor prefix and 'rh_depth' field name on non-RH repos",
      "repro": "bundles / decompile contract / export-site on examples/tiny_demo",
      "observed": "bundles and decompile contract emit anchor 'src/Bundles.lean:10' and 'src/Main.lean:12' even though tiny_demo has src_dir='.' (Bundles.lean / Main.lean). bundles and export_site emit RH-named key 'rh_depth'."
    },
    {
      "id": "XREPO-07",
      "severity": "LOW",
      "component": "leanre/config.py",
      "title": "leanre init emits unqualified headline root names and empty headline list when root file only re-exports",
      "repro": "leanre init examples/tiny_demo | PrimeNumberTheoremAnd | SpherePacking",
      "observed": "tiny_demo leanre.toml lists unqualified 'main_theorem' instead of 'TinyDemo.main_theorem'; PNT+ and SpherePacking yield headline=[] because root .lean files only contain imports."
    },
    {
      "id": "XREPO-08",
      "severity": "LOW",
      "component": "leanre/forensics.py & leanre/kernel.py & leanre/scanner.py",
      "title": "RH reference constants and metadata keys leak into generic forensics/kernel JSON reports",
      "repro": "leanre forensics on PNT+/carleson/FLT/SpherePacking; leanre kernel extract --report on tiny_demo; leanre scan on PNT+",
